# --- Telegram ---
# Токен бота от @BotFather
BOT_TOKEN=123456:AA...
# username бота без @ — используется для ссылок вида t.me/<bot>?startapp=...
BOT_USERNAME=lifeweeks_bot

# --- Mini App ---
# Публичный URL Mini App (нужен для кнопки WebApp в боте)
WEBAPP_URL=https://lifeweeks.pukikuki.ru

# --- База данных ---
DATABASE_URL=postgresql://lifeweeks:CHANGE_ME@127.0.0.1:5432/lifeweeks

# --- HTTP ---
API_HOST=127.0.0.1
API_PORT=5678

# --- Расписание рассылок ---
# Таймзона по умолчанию для новых пользователей (IANA)
DEFAULT_TIMEZONE=Europe/Moscow
# Время вечернего чек-ина в локальной таймзоне пользователя, HH:MM
DAILY_PROMPT_TIME=20:00
# Время утренней рассылки по понедельникам, HH:MM
WEEKLY_REPORT_TIME=09:00
# Как часто планировщик проверяет, кому пора слать (минуты).
# Должно быть делителем 60 и совпадать с гранулярностью времени выше.
SCHEDULER_TICK_MINUTES=5

# --- Прочее ---
# Разрешить запросы без подписи Telegram initData (ТОЛЬКО для локальной отладки)
ALLOW_INSECURE_AUTH=false
# Максимальный возраст initData в секундах
INIT_DATA_TTL=86400
LOG_LEVEL=INFO
